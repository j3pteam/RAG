+def _doc_advisors_ensure_table(conn):
+    with conn.cursor() as cur:
+        cur.execute("""
+            CREATE TABLE IF NOT EXISTS document_advisors (
+                title        TEXT NOT NULL,
+                advisor_slug TEXT NOT NULL,
