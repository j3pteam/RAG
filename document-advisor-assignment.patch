+            CREATE TABLE IF NOT EXISTS interaction_personality (
+                interaction_id    BIGINT PRIMARY KEY,
+                openness          SMALLINT,
+                conscientiousness SMALLINT,
+                extraversion      SMALLINT,
+                agreeableness     SMALLINT,
+                stability         SMALLINT,
+                recorded_at       TIMESTAMPTZ NOT NULL DEFAULT NOW()
+            )
+        """)
+    conn.commit()
