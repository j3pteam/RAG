# ---------------------------------------------------------------------------
# A brand. Copy this file, fill it in, and set these on the new Railway
# service. Everything the app shows a participant comes from here — the
# code is identical between deployments.
#
# Check your work with:  ./verify_brand.py brands/<yours>.env
# That renders the real participant page against these values and reports
# any place the previous brand still shows through.
# ---------------------------------------------------------------------------

# --- Identity. Every one of these is required. ------------------------------
ORG_NAME=
# The full organization name, e.g. Meridian Advisory

ORG_SHORT=
# What the advisor calls the firm mid-sentence, e.g. Meridian

ORG_LEGAL_NAME=
# The entity named in the liability release participants accept.
# Get this exactly right — it is the one string with legal weight.

ORG_PRINCIPAL=
# The person whose thinking the persona is grounded in, e.g. Dana Cole

PERSONA_NAME=
# The product's name, e.g. Meridian Advisor

CONTACT_EMAIL=
# Where participants are directed for help. Must be theirs, not yours.

ORG_NAMING_RULES=
# Entity names that could be confused with theirs. Most firms have none —
# leave it empty. Empty is a real answer here, not an unfilled blank.

# --- Look ------------------------------------------------------------------
BRAND_LOGO_URL=
BRAND_FAVICON_URL=
BRAND_NAVY=#27334A
BRAND_GOLD=#D2BC8D
BRAND_PAPER=#FAF6F0
ADVISOR_AVATAR_URL=
ADVISOR_LOOP_URL=
TALKING_AVATAR=off

# --- Copy. Leave blank to use the defaults, which are already branded. -----
PERSONA_OPENING=
PERSONA_PLACEHOLDER=
FOOTER_DISCLAIMER=
FOOTER_AI_NOTE=
FOOTER_CTA_LABEL=
FOOTER_CTA_TEXT=
FOOTER_CTA_URL=

# --- Operations. Not branding, but a deployment does not work without them. -
FLASK_SECRET_KEY=
# REQUIRED. A fixed random value. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Unset, each worker signs cookies with its own key and sessions drop at
# random. This is the single most common way a new deployment feels broken.

DATABASE_PRIVATE_URL=
# Railway's internal Postgres address. Without it every database round trip
# goes over the public proxy and the whole app is slower.

ADMIN_PASSWORD=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
ELEVENLABS_API_KEY=
# Only needed if this deployment uses voice cloning.

SAFETY_ALERT_EMAIL=
# Who receives participant-safety alerts. Must be someone at this
# organization who will actually read them.
